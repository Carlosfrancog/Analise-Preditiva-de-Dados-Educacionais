{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nestor Reader Inventory 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer",
    "repository",
    "commit",
    "generated_at",
    "evidence",
    "findings",
    "gaps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "producer": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "line",
          "label",
          "observation",
          "method"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "line": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "symbol": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "enum": [
              "FACT",
              "INFERENCE",
              "HYPOTHESIS",
              "UNKNOWN"
            ]
          },
          "observation": {
            "type": "string"
          },
          "method": {
            "enum": [
              "read-code",
              "static-text",
              "AST",
              "database-readonly",
              "documentation",
              "user-statement",
              "test-evidence"
            ]
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "description",
          "evidence_refs",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "label": {
            "type": "string",
            "enum": [
              "FACT",
              "INFERENCE",
              "HYPOTHESIS",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
