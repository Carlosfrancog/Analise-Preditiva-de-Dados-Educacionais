{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nestor Schema Validation Report 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "checks",
    "database_modified",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "repository": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASSED",
              "FAILED",
              "BLOCKED",
              "NOT_RUN"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "command": {
            "type": "string"
          }
        }
      }
    },
    "database_modified": {
      "const": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
