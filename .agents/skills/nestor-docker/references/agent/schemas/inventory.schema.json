{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nestor.local/docker/1.0/inventory.schema.json",
  "title": "Nestor Docker inventory",
  "description": "Estado inventariado com coleta permitida e natureza da evidência",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "test",
        "homolog",
        "prod",
        "unknown"
      ]
    },
    "collection_mode": {
      "type": "string",
      "enum": [
        "offline",
        "live",
        "hybrid"
      ]
    },
    "docker_context": {
      "type": [
        "string",
        "null"
      ]
    },
    "collected_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "engine_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "compose_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "state": {
            "type": [
              "string",
              "null"
            ]
          },
          "image": {
            "type": [
              "string",
              "null"
            ]
          },
          "health": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "kind",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "enum": [
              "FACT",
              "INFERENCE",
              "HYPOTHESIS",
              "UNKNOWN"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "collected_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "context": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "confirmed",
              "probable",
              "uncertain",
              "not_assessed"
            ]
          }
        },
        "required": [
          "label",
          "statement",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "environment",
    "collection_mode",
    "services",
    "files",
    "evidence",
    "limitations"
  ],
  "additionalProperties": false
}
