{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nestor.local/docker/1.0/change-plan.schema.json",
  "title": "Nestor Docker change plan",
  "description": "Planejamento e gates antes de mutação",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "test",
        "homolog",
        "prod",
        "unknown"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4"
      ]
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "approval_required": {
            "type": "boolean"
          }
        },
        "required": [
          "action",
          "target",
          "reason",
          "approval_required"
        ],
        "additionalProperties": false
      }
    },
    "authorization": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "approved",
            "required",
            "denied",
            "not_applicable"
          ]
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "data_impact": {
      "type": "string"
    },
    "service_impact": {
      "type": "string"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical",
              "unknown"
            ]
          },
          "mitigation": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "description",
          "severity"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "environment",
    "objective",
    "risk_level",
    "changes",
    "authorization",
    "data_impact",
    "service_impact",
    "validation_steps",
    "rollback_steps"
  ],
  "additionalProperties": false
}
