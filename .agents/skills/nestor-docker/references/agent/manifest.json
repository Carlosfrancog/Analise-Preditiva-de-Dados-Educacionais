{
  "manifest_version": "1.0",
  "agent": {
    "name": "Nestor Docker",
    "slug": "nestor-docker",
    "version": "1.0.0",
    "profile": "coder",
    "language": "pt-BR",
    "llm_agnostic": true,
    "mission_file": "AGENT.md"
  },
  "traits": {
    "analysis_first": true,
    "token_economy": false,
    "database_aware": true,
    "profile": "coder"
